{
  "name": "langlsrw",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "node tools/build-web.mjs",
    "build:dictionary": "python tools/build-ecdict.py",
    "build:dictionary:es": "python tools/build-spanish-dictionary.py",
    "vendor:sqlite": "node tools/vendor-sqlite-wasm.mjs",
    "prepare:dictionary": "npm run vendor:sqlite && npm run build:dictionary",
    "test:dictionary": "python tools/test-ecdict-build.py",
    "test:grammar-library": "node tools/test-grammar-library.mjs",
    "build:grammar-reading": "node tools/build-grammar-reading.mjs"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.51.2-build8"
  }
}
